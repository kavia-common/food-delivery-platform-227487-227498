# Frontend environment variables (do not commit real secrets)
# REST base URL of FastAPI backend (optional). Examples:
# REACT_APP_API_BASE_URL=http://localhost:3001
# REACT_APP_API_BASE_URL=https://your-backend.example.com
REACT_APP_API_BASE_URL=http://localhost:3001
#
# WebSocket base URL (optional). If omitted, derived from REACT_APP_API_BASE_URL by scheme conversion.
# Example:
# REACT_APP_WS_BASE_URL=ws://localhost:3001
REACT_APP_WS_BASE_URL=
